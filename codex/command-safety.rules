# Canonical Codex command rules. Link from ~/.codex/rules/command-safety.rules.
# Only the unrecoverable is blocked here, mirroring the Claude deny tier in
# instructions/git-operations.md. Prefix rules catch the common spellings only;
# other forms fall to the instructions. Everything else is judged by the agent from
# the instructions (ask when unclear or when work could be lost); see permissions.md.

prefix_rule(
    pattern = ["rm", ["-rf", "-fr"], "/"],
    decision = "forbidden",
    justification = "Never recursively delete the filesystem root. Select the exact task-owned directory instead.",
    match = ["rm -rf /", "rm -fr /"],
    not_match = ["rm -rf /tmp/task-scratch"],
)

prefix_rule(
    pattern = ["git", "push", ["--force", "-f"]],
    decision = "forbidden",
    justification = "Never use a bare force push. An authorized feature-branch rewrite must use --force-with-lease; never rewrite or delete the default branch.",
    match = ["git push --force origin feature", "git push -f origin feature"],
    not_match = ["git push --force-with-lease origin feature"],
)
