{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "-c",
        "exec pnpm dlx @playwright/mcp --config \"${PLAYWRIGHT_MCP_BROWSER_CONFIG:-$HOME/.claude/mcp/playwright-browser.json}\" --output-dir \"$(mktemp -d \"${TMPDIR:-/tmp}/playwright-mcp.XXXXXX\")\""
      ],
      "env": {}
    }
  }
}
