{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash",
      "Write",
      "Edit",
      "NotebookEdit",
      "Task",
      "Agent",
      "Skill",
      "Monitor",
      "Artifact",
      "mcp__supabase",
      "mcp__sentry",
      "mcp__playwright",
      "mcp__codegraph",
      "mcp__convex",
      "mcp__next-devtools",
      "mcp__ide",
      "mcp__plugin_convex_convex",
      "mcp__plugin_playwright_playwright",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(tree:*)",
      "Bash(file:*)",
      "Bash(wc:*)",
      "Bash(stat:*)",
